{
  "name": "project-meal-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Project Meal Planner: PWA personale per calendario dei pasti e spesa, pronta per GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --dir dist",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "verify:build": "node scripts/verify-release.mjs",
    "verify:deployment": "node scripts/verify-release.mjs --url"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  }
}
